{"producerArgs":["--input-type=module","-e","import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash}from'node:crypto';import {createGunzip}from'node:zlib';import Parser from 'jsonparse';const census=JSON.parse(fs.readFileSync('artifacts/material-parity/stepper-selection-census-20261022.log'));const wanted=new Set(Object.keys(census.sectionDigests)),found={};const p=new Parser(),hash=createHash('sha256');p.onValue=function(v){const top=this.stack[1]?.key??(this.stack.length===1?this.key:undefined);if(this.stack.length===1&&wanted.has(this.key)){found[this.key]={count:v.length,sha256:createHash('sha256').update(JSON.stringify(v)).digest('hex')};delete this.value[this.key];}else if(this.stack.length&& !wanted.has(top))delete this.value[this.key];};for await(const c of fs.createReadStream('docs/material-input-equivalence-audit.json.gz').pipe(createGunzip())){hash.update(c);p.write(c);}const manifest=JSON.parse(fs.readFileSync('docs/material-input-equivalence-audit.json'));assert.equal(hash.digest('hex'),manifest.uncompressedSha256);for(const [k,v]of Object.entries(census.sectionDigests))assert.equal(found[k].sha256,v,k);console.log(JSON.stringify({producerArgs:process.execArgv,generation:manifest.compressedSha256,sections:found,exactRegisteredCensus:true,priorConservation:'Bound to retained registration census;does not certify rendering or cold replay.'}));"],"generation":"8d6c596421e6b96018328199aea28981b85d15921c611fe2b1837b3b412a976f","sections":{"sourceFingerprints":{"count":856,"sha256":"d0b9aa73c31fb9cfff7af9447f286f0da5aaf72cd4280593d25c538140f7658b"},"sourceFindings":{"count":179,"sha256":"8f402d4fee413f02010c0f0637f6c353476d6585eaa8e578d42828d8648795b7"},"focusedProofs":{"count":241,"sha256":"fc02c6cf2193c35c66c7ede7b8433e88d9b0f587c32e21b8caea4afdac3d650c"}},"exactRegisteredCensus":true,"priorConservation":"Bound to retained registration census;does not certify rendering or cold replay."}
