{"producerArgs":["--input-type=module","-e","import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{queryFindings,loadFindingEvidence}from'./scripts/audit-findings-store.mjs';import{collectOwnerInitialMotion}from'./scripts/audit-material-owner-initial-motion.mjs';import{restoreSharedButtonTouchProducer}from'./tests/material-parity/button-touch-registration.mjs';const hash=x=>createHash('sha256').update(x).digest('hex');const leavesFile='artifacts/material-parity/button-touch-propagated-leaves-20261021.log',bytes=fs.readFileSync(leavesFile),r=JSON.parse(bytes);assert.equal(r.changes.length,147);const old='d97e15b446f6fe5c53688f3ff504fed86dd1793d0912cb39f374a77abe9c6ea7',fresh='cca481561332a3ae872d49318014f5c4faa0e37cf6f03503e4a7c85024e5c284';const source=fs.readFileSync('tests/material-parity/input-equivalence-audit.mjs');assert.equal(hash(source.toString().replaceAll('\\r\\n','\\n')),fresh);assert.equal(hash(restoreSharedButtonTouchProducer(source)),old);const direct=r.changes.filter(c=>['currentModuleSha256','current','currentSha256'].includes(c.path.at(-1)));assert.equal(direct.length,98);for(const c of direct){assert.equal(c.before,old);assert.equal(c.after,fresh)}const selected=r.changes.filter(c=>c.path[0]==='controlTypography');const ordinals=new Set(selected.map(c=>c.path[2]));const destination='artifacts/material-parity/working-audit/candidate-validation';const snapshot=JSON.parse(fs.readFileSync(destination+'/current.json'));assert.equal(snapshot.generation,r.candidate);const rows=queryFindings(destination,'button',snapshot).filter(x=>x.evidence.section==='controlTypography.differences'&&ordinals.has(x.evidence.ordinal));assert.equal(rows.length,48);const actual=await loadFindingEvidence(destination,'button',rows.map(x=>x.id),snapshot);const replacements=new Map();for(const value of actual){const previous=structuredClone(value);assert.equal(previous.reviewEvidence.observation.normalizationReconciliation.currentModuleSha256,fresh);previous.reviewEvidence.observation.normalizationReconciliation.currentModuleSha256=old;replacements.set(hash(JSON.stringify(previous)),hash(JSON.stringify(value)))}const derived=r.changes.filter(c=>c.path.at(-1)==='controlProofSha256');assert.equal(derived.length,48);for(const c of derived)assert.equal(replacements.get(c.before),c.after);const motion=collectOwnerInitialMotion();const reportChange=r.changes.filter(c=>c.path.at(-1)==='currentReportSha256');assert.equal(reportChange.length,1);const reportHash=x=>hash(JSON.stringify(x,null,2)+'\\n');assert.equal(reportHash(motion),reportChange[0].after);const moduleReceipt=motion.sourceFingerprints.filter(x=>x.file==='tests/material-parity/input-equivalence-audit.mjs');assert.equal(moduleReceipt.length,1);assert.equal(moduleReceipt[0].sha256,fresh);moduleReceipt[0].sha256=old;assert.equal(reportHash(motion),reportChange[0].before);assert.equal(direct.length+derived.length+reportChange.length,r.changes.length);console.log(JSON.stringify({producerArgs:process.execArgv,leafComparison:{file:leavesFile,sha256:hash(bytes)},changedLeaves:147,directProducerReceipts:98,recomputedControlProofs:48,recomputedMotionReports:1,exactPriorProducerRecovered:true,allSelectedNonReceiptValuesAndContainersConserved:true,boundary:'Derived hashes recomputed from authenticated complete current control rows and existing motion collector;no classification,measurement,remaining-work or rendering flag change is authorized.'}));"],"leafComparison":{"file":"artifacts/material-parity/button-touch-propagated-leaves-20261021.log","sha256":"3f0fef88afa5e82f60d5b8286d316573707b08662f0362a779de788c543ac2a2"},"changedLeaves":147,"directProducerReceipts":98,"recomputedControlProofs":48,"recomputedMotionReports":1,"exactPriorProducerRecovered":true,"allSelectedNonReceiptValuesAndContainersConserved":true,"boundary":"Derived hashes recomputed from authenticated complete current control rows and existing motion collector;no classification,measurement,remaining-work or rendering flag change is authorized."}
