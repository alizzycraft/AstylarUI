{"producerArgs":["--input-type=module","-e","import ts from 'typescript';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport assert from 'node:assert/strict';\nimport { createHash } from 'node:crypto';\nimport { execFileSync } from 'node:child_process';\nimport { sourceAuditDefinitions as definitions } from './tests/material-parity/input-equivalence-policy.mjs';\nimport { passiveMainPredecessor, restorePassiveMainPolicy, restorePassiveMainProducer } from './tests/material-parity/passive-main-registration.mjs';\nconst revision='06441205', file='tests/material-parity/input-equivalence-audit.mjs';\nconst normalize=b=>b.toString().replaceAll('\\r\\n','\\n'),hash=b=>createHash('sha256').update(b).digest('hex');\nconst changed=['input-equivalence-policy.mjs','input-equivalence-audit.mjs','native-checkable-registration.mjs','native-checkable-inputs.spec.mjs'].map(f=>'tests/material-parity/'+f);\nconst originals=new Map(changed.map(f=>[path.resolve(f),execFileSync('git',['show',revision+':'+f],{maxBuffer:4000000})]));\nassert.equal(restorePassiveMainPolicy(fs.readFileSync(changed[0])),normalize(originals.get(path.resolve(changed[0]))));\nassert.equal(restorePassiveMainProducer(fs.readFileSync(file)),normalize(originals.get(path.resolve(file))));\nfunction functions(source,read,defs){const ast=ts.createSourceFile('audit.mjs',source,99,true);const bodies=['scanMaterialSources','sourceFingerprints','focusedProofInventory','proof'].map(name=>{const n=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);assert.ok(n);return n.getText(ast)}).join('\\n');return new Function('readFileSync','path','createHash','sourceAuditDefinitions',bodies+'\\nreturn {scanMaterialSources,sourceFingerprints,focusedProofInventory};')(read,path,createHash,defs)}\nconst oldRead=(f,...args)=>{const b=originals.get(path.resolve(f));return b?(args[0]==='utf8'?b.toString():b):fs.readFileSync(f,...args)};\nconst collect=f=>({sourceFingerprints:f.sourceFingerprints(process.cwd()),focusedProofs:f.focusedProofInventory(process.cwd()),sourceFindings:f.scanMaterialSources(process.cwd())});\nconst before=collect(functions(originals.get(path.resolve(file)).toString(),oldRead,passiveMainPredecessor(definitions)));\nconst after=collect(functions(fs.readFileSync(file,'utf8'),fs.readFileSync,definitions));\nassert.deepEqual([before.sourceFingerprints.length,before.focusedProofs.length,before.sourceFindings.length],[790,232,173]);\nassert.deepEqual([after.sourceFingerprints.length,after.focusedProofs.length,after.sourceFindings.length],[804,234,175]);\nassert.deepEqual(after.sourceFindings.slice(0,-2),before.sourceFindings);\nassert.ok(after.sourceFindings.every(r=>r.detected));assert.ok(after.focusedProofs.every(r=>r.status!=='missing'));\nconst proofLines=[];assert.deepEqual(after.focusedProofs.slice(2).map((r,i)=>{if(r.line!==before.focusedProofs[i].line)proofLines.push({file:r.file,status:r.status,before:before.focusedProofs[i].line,after:r.line});return {...r,line:before.focusedProofs[i].line}}),before.focusedProofs);\nconst oldPaths=new Map(before.sourceFingerprints.map(r=>[r.file,r]));const newPaths=new Map(after.sourceFingerprints.map(r=>[r.file,r]));for(const f of oldPaths.keys())assert.ok(newPaths.has(f));\nconsole.log(JSON.stringify({producerArgs:process.execArgv,revision,counts:{before:[790,232,173],after:[804,234,175]},prior173FindingsPreserved:true,prior232ProofClaimsPreserved:true,prior790SourcePathsPreserved:true,proofLines,addedSources:after.sourceFingerprints.filter(r=>!oldPaths.has(r.file)),changedSources:after.sourceFingerprints.filter(r=>oldPaths.has(r.file)&&JSON.stringify(r)!==JSON.stringify(oldPaths.get(r.file))),sectionDigests:Object.fromEntries(Object.entries(after).map(([k,v])=>[k,hash(JSON.stringify(v))])),canonicalPublication:false}));"],"revision":"06441205","counts":{"before":[790,232,173],"after":[804,234,175]},"prior173FindingsPreserved":true,"prior232ProofClaimsPreserved":true,"prior790SourcePathsPreserved":true