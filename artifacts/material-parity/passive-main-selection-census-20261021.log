{"producerArgs":["--input-type=module","-e","import ts from 'typescript';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport assert from 'node:assert/strict';\nimport { createHash } from 'node:crypto';\nimport { execFileSync } from 'node:child_process';\nimport { sourceAuditDefinitions as definitions } from './tests/material-parity/input-equivalence-policy.mjs';\nimport { passiveMainPredecessor, restorePassiveMainPolicy, restorePassiveMainProducer } from './tests/material-parity/passive-main-registration.mjs';\nconst revision='06441205', file='tests/material-parity/input-equivalence-audit.mjs';\nconst normalize=b=>b.toString().replaceAll('\\r\\n','\\n'),hash=b=>createHash('sha256').update(b).digest('hex');\nconst changed=[\"tests/material-parity/input-equivalence-policy.mjs\",\"tests/material-parity/input-equivalence-audit.mjs\",\"tests/material-parity/native-checkable-registration.mjs\",\"tests/material-parity/native-checkable-inputs.spec.mjs\",\"tests/material-parity/button-touch-registration.mjs\",\"tests/material-parity/text-backing-case-review-source.mjs\",\"scripts/run-material-input-audit.mjs\",\"scripts/export-material-input-audit-current-ancestry.mjs\"];\nconst originals=new Map(changed.map(f=>[path.resolve(f),execFileSync('git',['show',revision+':'+f],{maxBuffer:4000000})]));\nassert.equal(restorePassiveMainPolicy(fs.readFileSync(changed[0])),normalize(originals.get(path.resolve(changed[0]))));\nassert.equal(restorePassiveMainProducer(fs.readFileSync(file)),normalize(originals.get(path.resolve(file))));\nfunction functions(source,read,defs){const ast=ts.createSourceFile('audit.mjs',source,99,true);const bodies=['scanMaterialSources','sourceFingerprints','focusedProofInventory','proof'].map(name=>{const n=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);assert.ok(n);return n.getText(ast)}).join('\\n');return new Function('readFileSync','path','createHash','sourceAuditDefinitions',bodies+'\\nreturn {scanMaterialSources,