{"producerArgs":["--input-type=module","-e","import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';const file='D:/dev/github/AstylarUI-material/tests/material-parity/run-material-parity.mjs';const b=fs.readFileSync(file);const sha=createHash('sha256').update(b).digest('hex');assert.equal(sha,'b2477a124293aec6bba3a2413ff58d41f409288dcf0cb53a54ed17d162b9fa97');const s=b.toString();const start=s.indexOf('const referenceMeasurement = await measureReference(reference.page, ids);');const image=s.indexOf('captureInteractionImage(reference.page',start);const release=s.indexOf('for (const release of heldReleases)',image);assert.ok(start>0&&image>start&&release>image);const fn=s.indexOf('async function captureInteractionImage(');assert.ok(fn>0);const end=s.indexOf('\\n}',fn);const body=s.slice(fn,end+2);assert.match(body,/animations:\\s*.disabled./);console.log(JSON.stringify({producerArgs:process.execArgv,originalSource:{file,sha256:sha},sequenceOffsets:{referenceMeasurement:start,image,release},captureImageFunction:body,boundary:'Exact historical capture source establishes sequential input measurement then screenshots with animations disabled before held release. No animation timestamp or local pixel equivalence is established by this ordering;no actual mismatch or harness defect inferred.'}));"],"originalSource":{"file":"D:/dev/github/AstylarUI-material/tests/material-parity/run-material-parity.mjs","sha256":"b2477a124293aec6bba3a2413ff58d41f409288dcf0cb53a54ed17d162b9fa97"},"sequenceOffsets":{"referenceMeasurement":20386,"image":21167,"release":21383},"captureImageFunction":"async function captureInteractionImage(page, mode, measurement, family, state, directory) {\r\n  const filename = path.join(directory, `${mode}.png`);\r\n  void mode;\r\n  void measurement;\r\n  void family;\r\n  void state;\r\n  return page.screenshot({ path: filename, animations: 'disabled' });\r\n}","boundary":"Exact historical capture source establishes