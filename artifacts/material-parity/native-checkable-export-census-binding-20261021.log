{"producerArgs":["--input-type=module","-e","import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash}from'node:crypto';import {createGunzip}from'node:zlib';import Parser from 'jsonparse';const census=JSON.parse(fs.readFileSync('artifacts/material-parity/native-checkable-registration-census-20261021.log'));const wanted=new Set(Object.keys(census.sectionDigests)),found={};const p=new Parser(),hash=createHash('sha256');p.onValue=function(v){const top=this.stack[1]?.key??(this.stack.length===1?this.key:undefined);if(this.stack.length===1&&wanted.has(this.key)){found[this.key]={count:v.length,sha256:createHash('sha256').update(JSON.stringify(v)).digest('hex')};delete this.value[this.key];}else if(this.stack.length&& !wanted.has(top))delete this.value[this.key];};for await(const c of fs.createReadStream('docs/material-input-equivalence-audit.json.gz').pipe(createGunzip())){hash.update(c);p.write(c);}const manifest=JSON.parse(fs.readFileSync('docs/material-input-equivalence-audit.json'));assert.equal(hash.digest('hex'),manifest.uncompressedSha256);for(const [k,v]of Object.entries(census.sectionDigests))assert.equal(found[k].sha256,v,k);console.log(JSON.stringify({producerArgs:process.execArgv,generation:manifest.compressedSha256,sections:found,exactRegisteredCensus:true,priorConservation:'Bound to retained registration census;does not certify rendering or cold replay.'}));"],"generation":"c2a58b7c35fed299da02fe92043d58f98102d3724ce69070bc4ef6aaa2c744e8","sections":{"sourceFingerprints":{"count":790,"sha256":"4738e4e32c6d3c1471c197b3a8ef0f1959922c91612a4e4bcb07f52de818278f"},"sourceFindings":{"count":173,"sha256":"72ccfb0ae7dfb3ac05ab6db1ee364a48ded5eaa5a7d4f63961171b5dae2ef768"},"focusedProofs":{"count":232,"sha256":"a5f954fdb8202ffecd60430a13b86fe76499ccfbcd59bf57e5d5b4751931c9bd"}},"exactRegisteredCensus":true,"priorConservation":"Bound to retained registration census;does not certify rendering or cold replay."}
