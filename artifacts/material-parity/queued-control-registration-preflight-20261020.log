{"command":"@'\nimport ts from 'typescript';import fs from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';import assert from 'node:assert/strict';import {sourceAuditDefinitions} from './tests/material-parity/input-equivalence-policy.mjs';import {sectionDigests} from './scripts/material-audit-section-digests.mjs';\nconst file='tests/material-parity/input-equivalence-audit.mjs',source=fs.readFileSync(file,'utf8'),ast=ts.createSourceFile(file,source,ts.ScriptTarget.Latest,true),names=['scanMaterialSources','sourceFingerprints','focusedProofInventory','proof'];\nconst bodies=names.map(name=>{const n=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);assert.ok(n);return n.getText(ast)}).join('\\n');\nconst f=new Function('readFileSync','path','createHash','sourceAuditDefinitions',bodies+'\\nreturn {scanMaterialSources,sourceFingerprints,focusedProofInventory};')(fs.readFileSync,path,createHash,sourceAuditDefinitions);\nconst sources=f.sourceFingerprints(process.cwd()),proofs=f.focusedProofInventory(process.cwd()),findings=f.scanMaterialSources(process.cwd());\nassert.deepEqual([sources.length,proofs.length,findings.length],[756,226,170]);assert.equal(proofs.filter(p=>p.status==='missing').length,0);assert.ok(findings.every(f=>f.detected));\nconst tracked=new Set(execFileSync('git',['ls-tree','-r','--name-only','437a4535'],{encoding:'utf8',maxBuffer:4000000}).trim().split('\\n'));\nconst oldSources=structuredClone(sources.slice(13)),changed=[];\nfor(const row of oldSources){if(!tracked.has(row.file)||!(/^(tests\\/material-parity\\/|scripts\\/audit-material-case-index-conservation\\.mjs$)/.test(row.file)))continue;const prior=createHash('sha256').update(execFileSync('git',['show','437a4535:'+row.file],{maxBuffer:4000000}).toString().replaceAll('\\r\\n','\\n')).digest('hex');if(prior!==row.sha256){changed.push({file:row.file,before:prior,after:row.sha256});row.sha256=prior;}}\nconst restored=await sectionDigests([Buffer.from(JSON.stringify({sourceFingerprints:oldSources,focusedProofs:proofs.slice(6),sourceFindings:findings.slice(0,166)}))]);\nfor(const [name,sha] of [['sourceFingerprints','04e548574f4fd43ffc1dc34aa678344026170d9550ede6b5a15d41a6fb2dc152'],['focusedProofs','07065eba46f8650f81ae61487fd7b78f374be3465342ec39cbedbda6305865ce'],['sourceFindings','beb3da46b4a1ed1d4187e69078c85328a6a8233eb7f3e4f2c17a4ec23716a2f1']])assert.equal(restored.find(r=>r.name===name).sha256,sha,name);\nconsole.log(JSON.stringify({kind:'queued-control-registration-preflight',method:'AST-extracted unchanged production functions; tracked sources restored from Git437a4535; complete predecessor section digests verified including untracked evidence; no full builder/browser',counts:{sources:sources.length,proofs:proofs.length,findings:findings.length},restored,changed,addedSourceFiles:sources.slice(0,13),addedFindings:findings.slice(166).map(f=>({id:f.id,locations:f.locations})),canonicalUnchanged:true,caseJoinPending:true},null,2));\n'@ | node --input-type=module","exitCode":0}
