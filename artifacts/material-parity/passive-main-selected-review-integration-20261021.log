{"producerArgs":["--max-old-space-size=8192","--input-type=module","-e","import fs from 'node:fs';\nimport assert from 'node:assert/strict';\nimport {createHash} from 'node:crypto';\nimport {loadCaseObligationReview} from './scripts/audit-findings-store.mjs';\nimport {createDividerReviewedBoundariesReader,passiveStaticAxReview,sharedButtonTouchReview} from './tests/material-parity/text-backing-case-review-source.mjs';\nconst hash=value=>createHash('sha256').update(value).digest('hex');\nconst file='artifacts/material-parity/working-audit/proposals/'+passiveStaticAxReview+'.json';\nconst bytes=fs.readFileSync(file),envelope=JSON.parse(bytes),review=envelope.review;\nassert.equal(hash(JSON.stringify(review)),passiveStaticAxReview);\nconst reader=createDividerReviewedBoundariesReader({root:process.cwd(),read:fs.readFileSync,reviewSha256:passiveStaticAxReview});\nassert.equal(reader.sourceApplicability.currentSourceChecks.length,12);\nassert.throws(()=>createDividerReviewedBoundariesReader({root:process.cwd(),read:fs.readFileSync,reviewSha256:'0'.repeat(64)}));\nconst loaded=loadCaseObligationReview(file,passiveStaticAxReview,review.groups.map(g=>g.case),{read:reader.read});\nassert.equal(loaded.cases.length,2311);assert.equal(loaded.inspectionComplete,false);assert.equal(loaded.currentRenderingAccepted,false);assert.deepEqual(loaded.unjoinedCases,[]);\nlet removed=0;const families={};\nfor(const row of review.groups){assert.equal(row.inspection,'partial');assert.equal(row.currentRendering,'unverified');if(row.obligations.semantics.currentStaticActualAx){assert.ok(row.case.startsWith('static:'));delete row.obligations.semantics.currentStaticActualAx;removed++;families[row.family]=(families[row.family]??0)+1;}}\nassert.equal(removed,48);assert.deepEqual(families,{sidenav:12,'grid-list':12,table:12,list:12});\nassert.equal(hash(JSON.stringify(review)),sharedButtonTouchReview);\nconsole.log(JSON.stringify({producerArgs:process.execArgv,proposal:{file,sha256:hash(bytes),reviewSha256:passiveStaticAxReview},cases:2311,addedStaticCases:48,families,validatedDependencies:loaded.evidenceFingerprints.length,sourceChecks:12,completePredecessorRecovered:true,inspectionComplete:false,currentRenderingAccepted:false,canonicalPublication:false}));"],"proposal":{"file":"artifacts/material-parity/working-audit/proposals/33b7ccf93a9df72a878ba302c5a0b8867ef01a2b24cb81a47a59e9c7a5b16460.json","sha256":"073e989b6c996a897c881f40417866e39f47ff83c827fa4287657baa484b82de","reviewSha256":"33b7ccf93a9df72a878ba302c5a0b8867ef01a2b24cb81a47a59e9c7a5b16460"},"cases":2311,"addedStaticCases":48,"families":{"sidenav":12,"grid-list":12,"list":12,"table":12},"validatedDependencies":15388,"sourceChecks":12,"completePredecessorRecovered":true,"inspectionComplete":false,"currentRenderingAccepted":false,"canonicalPublication":false}
