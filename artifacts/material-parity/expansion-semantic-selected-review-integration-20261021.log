{"producerArgs":["--input-type=module","-e","import fs from \"node:fs\";import assert from \"node:assert/strict\";import{createHash}from\"node:crypto\";import{loadCaseObligationReview}from\"./scripts/audit-findings-store.mjs\";import{createDividerReviewedBoundariesReader,expansionSemanticsReview}from\"./tests/material-parity/text-backing-case-review-source.mjs\";const base=\"artifacts/material-parity/working-audit\",id=expansionSemanticsReview,file=base+\"/proposals/\"+id+\".json\",hash=b=>createHash(\"sha256\").update(b).digest(\"hex\"),review=JSON.parse(fs.readFileSync(file)).review;assert.equal(id,\"5caa57e5f2254471d9d082ff0831db36704f73997b41ae48aa4b4064b45c4c99\");assert.equal(hash(JSON.stringify(review)),id);const reader=createDividerReviewedBoundariesReader({root:process.cwd(),read:fs.readFileSync,reviewSha256:id}),loaded=loadCaseObligationReview(file,id,review.groups.map(r=>r.case),{read:reader.read});assert.equal(loaded.cases.length,2311);assert.equal(loaded.inspectionComplete,false);assert.equal(loaded.currentRenderingAccepted,false);assert.deepEqual(loaded.unjoinedCases,[]);let targets=0,ax=0;for(const row of review.groups.filter(r=>r.family===\"expansion\")){const s=row.obligations.semantics;assert.ok(s.retainedExpansionTargetInputs);delete s.retainedExpansionTargetInputs;targets++;if(s.currentStaticActualAx){assert.ok(row.case.startsWith(\"static:\"));delete s.currentStaticActualAx;ax++}}assert.equal(targets,68);assert.equal(ax,12);assert.equal(hash(JSON.stringify(review)),\"20dfb80485f094eaec4025e56ac7d5bb4a375f388643d192cb14f5d5fecbf82b\");assert.throws(()=>createDividerReviewedBoundariesReader({root:process.cwd(),read:fs.readFileSync,reviewSha256:\"f\".repeat(64)}));console.log(JSON.stringify({producerArgs:process.execArgv,id,cases:loaded.cases.length,dependencies:loaded.evidenceFingerprints.length,currentSourceChecks:reader.sourceApplicability.currentSourceChecks.length,retainedTargetChildren:targets,staticAxChildren:ax,completePriorReviewRecovered:true,inspectionComplete:false,currentRenderingAccepted:false}));"],"id":"5caa57e5f2254471d9d082ff0831db36704f73997b41ae48aa4b4064b45c4c99","cases":2311,"dependencies":15588,"currentSourceChecks":12,"retainedTargetChildren":68,"staticAxChildren":12,"completePriorReviewRecovered":true,"inspectionComplete":false,"currentRenderingAccepted":false}
