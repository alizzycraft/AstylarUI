e.startsWith(browserRoot + path.sep) && path.extname(candidate) && existsSync(candidate)\n      ? candidate : path.join(browserRoot, 'index.csr.html');\n    const extension = path.extname(target);\n    response.writeHead(200, { 'content-type': extension === '.js' ? 'text/javascript' :\n      extension === '.css' ? 'text/css' : extension === '.woff2' ? 'font/woff2' : 'text/html' });\n    response.end(readFileSync(target));\n  });\n  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));\n  let browser;\n  try {\n    browser = await chromium.launch({ channel: 'chrome', headless: true, ...launchOptions });\n    await run(browser, `http://127.0.0.1:${server.address().port}`);\n  } finally {\n    if (browser) await browser.close();\n    await new Promise(resolve => server.close(resolve));\n  }\n}","helperSha256":"603ac9ca88b9bf2e3443f8be65f125d39002e1ca4e5157487d9ac86ed7d2527f","checkpointHelper":{"file":"tests/material-parity/run-checkpoint.mjs","sha256":"50d158b495bb881a126f76787f679e14702857f59c0f338e962bef57bf4394e0"}},"observations":[{"family":"card","profile":"light","viewport":{"id":"desktop","width":1440,"height":1000,"deviceScaleFactor":1},"mode":"reference","file":"card-light-1440x1000-dpr1-reference.json","sha256":"e775ebe61e61feca8b47dfd91f01576151f947f86e39193e19c0675c6d9ee5cb","axNodes":30,"describedBackendNodes":25},{"family":"card","profile":"light","viewport":{"id":"desktop","width":1440,"height":1000,"deviceScaleFactor":1},"mode":"astylar","file":"card-light-1440x1000-dpr1-astylar.json","sha256":"2c357196bc596c17953f584f6001423d8a624147a561125076f6b749598d4142","axNodes":27,"describedBackendNodes":22},{"family":"card","profile":"light","viewport":{"id":"tablet","width":768,"height":1024,"deviceScaleFactor":1},"mode":"reference","file":"card-light-768x1024-dpr1-reference.json","sha256":"20ac1cb9245dcb7c4f1dc912f9843299969af313042a986485704d9ac93670b0","axNodes":30,"describedBackendNodes":25},{"family":"card","profile":"light","viewport":{"