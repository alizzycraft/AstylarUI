{
  "producerArgs": [
    "--input-type=module",
    "-e",
    "\nimport assert from 'node:assert/strict';\nimport {readFileSync,existsSync} from 'node:fs';\nimport {createHash} from 'node:crypto';\nimport {createServer} from 'node:http';\nimport path from 'node:path';\nimport ts from 'typescript';\nimport {chromium} from 'playwright-core';\nimport {fingerprintDirectory} from './tests/material-parity/run-checkpoint.mjs';\nconst hash=v=>createHash('sha256').update(v).digest('hex'),receipt=file=>({file,sha256:hash(readFileSync(file))});\nconst helperFile='tests/material-parity/sort-focus-structure.spec.mjs';\nconst ast=ts.createSourceFile(helperFile,readFileSync(helperFile,'utf8'),99,true);\nconst helper=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text==='withFrozenShowcase').getText(ast);\nassert.equal(hash(helper),'603ac9ca88b9bf2e3443f8be65f125d39002e1ca4e5157487d9ac86ed7d2527f');\nconst withFrozen=new Function('assert','path','readFileSync','existsSync','createServer','chromium','fingerprintDirectory',helper+';return withFrozenShowcase;')(assert,path,readFileSync,existsSync,createServer,chromium,fingerprintDirectory);\n\nconst checkpointFile='artifacts/material-parity/divider-alignment-provenance-20261015/checkpoint/manifest.json';\nconst captures=[];\nawait withFrozen(async(browser,baseUrl)=>{\n for(const side of ['reference','astylar']){\n const context=await browser.newContext({viewport:{width:1440,height:1000},deviceScaleFactor:1});\n try{\n  const page=await context.newPage(),errors=[];\n  page.on('pageerror',e=>errors.push(e.message));\n  await page.goto(baseUrl+'/'+side+'/button?benchmark=1&profile=light');\n  if(side==='astylar'){\n   await page.waitForFunction(()=>typeof window.__ASTYLAR_MATERIAL_BENCHMARK__?.measure==='function');\n   await page.evaluate(()=>window.__ASTYLAR_MATERIAL_BENCHMARK__.waitForSettled());\n  }else await page.waitForFunction(()=>typeof window.__MATERIAL_SHOWCASE_COMMAND__==='function');\n  await page.evaluate(async()=>{await document.fonts.ready;await new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r)));});\n  const initial=await page.evaluate(side=>{\n   window.__BUTTON_EDGE_BROWSER_CLICKS__=[];\n   document.addEventListener('click',e=>window.__BUTTON_EDGE_BROWSER_CLICKS__.push({trusted:e.isTrusted,x:e.clientX,y:e.clientY,target:e.target.tagName,buttonId:e.target.closest('button')?.id??null}),true);\n   if(side==='reference'){\n    const button=document.querySelector('#button-primary'),r=button.getBoundingClientRect();\n    return {box:{left:r.left,top:r.top,right:r.right,bottom:r.bottom,width:r.width,height:r.height}};\n   }\n   const b=window.__ASTYLAR_MATERIAL_BENCHMARK__,m=b.measure(['button-primary']);\n   const canvas=document.querySelector('canvas'),r=canvas.getBoundingClientRect(),box=m.elements['button-primary'].borderBox;\n   const node=m.inputTree.nodes.find(n=>n.authored?.id==='button-primary');\n   return {box:{left:r.left+box.left,top:r.top+box.top,right:r.left+box.right,bottom:r.top+box.bottom,width:box.width,height:box.height},\n    canvas:{left:r.left,top:r.top,width:r.width,height:r.height},measuredBorderBox:box,authored:node.authored,\n    authoredChildren:m.inputTree.nodes.filter(n=>n.parent===node.key).map(n=>n.authored),state:b.state(),diagnostics:m.diagnostics};\n  },side);\n  assert.ok(Math.abs(initial.box.height-40)<.01);\n  const x=(initial.box.left+initial.box.right)/2;\n  const points=[{name:'above2',x,y:initial.box.top-2},{name:'below2',x,y:initial.box.bottom+2},\n   {name:'center',x,y:initial.box.top+initial.box.height/2},{name:'far-above8',x,y:initial.box.top-8},{name:'far-below8',x,y:initial.box.bottom+8}];\n  const trials=[];\n  for(const point of points){\n   await page.mouse.move(5,5);\n   await page.evaluate(side=>{window.__BUTTON_EDGE_BROWSER_CLICKS__=[];if(side==='astylar')window.__ASTYLAR_MATERIAL_BENCHMARK__.clearEvents();},side);\n   await page.mouse.click(point.x,point.y);\n   if(side==='astylar')await page.evaluate(()=>window.__ASTYLAR_MATERIAL_BENCHMARK__.waitForSettled());\n   const result=await page.evaluate(side=>({browser:window.__BUTTON_EDGE_BROWSER_CLICKS__,events:side==='astylar'?window.__ASTYLAR_MATERIAL_BENCHMARK__.events():[]}),side);\n   assert.equal(result.browser.length,1);assert.equal(result.browser[0].trusted,true);\n   const buttonClicks=side==='reference'?result.browser.filter(e=>e.buttonId==='button-primary'):result.events.filter(e=>e.type==='click'&&e.targetId==='button-primary');\n   if(point.name==='center')assert.equal(buttonClicks.length,1);\n   if(point.name.startsWith('far-'))assert.equal(buttonClicks.length,0);\n   if(side==='reference'&&['above2','below2'].includes(point.name))assert.equal(buttonClicks.length,1);\n   trials.push({point,buttonClickCount:buttonClicks.length,...result});\n  }\n  assert.deepEqual(errors,[]);\n  captures.push({side,runtime:{actualBrowser:browser.version(),historicalBrowserReplay:false},initial,trials,runtimeErrors:errors});\n }finally{await context.close();}\n }\n},{},{checkpointFile});\nconsole.log(JSON.stringify({producerArgs:process.execArgv,helper:{file:helperFile,functionSha256:hash(helper)},checkpoint:receipt(checkpointFile),captures,\n conclusion:'Paired fresh trusted pointer boundaries observe actual button activation outside and inside measured visible hosts,with center and far-outside controls. Inspect trial counts before assigning cause.',\n boundary:'One primary button light/desktopDPR1 context on frozen served build;newer browser patch,not historical replay or all variants. Source/fixture unchanged. An unequal-input hit difference does not by itself diagnose core;equal-input public reproduction remains required.'},null,2));\n"
