{"producerArgs":["--input-type=module","-e","import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash}from'node:crypto';import {createGunzip}from'node:zlib';import Parser from 'jsonparse';const census=JSON.parse(fs.readFileSync('artifacts/material-parity/tabs-selection-census-20261022.log'));const wanted=new Set(Object.keys(census.sectionDigests)),found={};const p=new Parser(),hash=createHash('sha256');p.onValue=function(v){const top=this.stack[1]?.key??(this.stack.length===1?this.key:undefined);if(this.stack.length===1&&wanted.has(this.key)){found[this.key]={count:v.length,sha256:createHash('sha256').update(JSON.stringify(v)).digest('hex')};delete this.value[this.key];}else if(this.stack.length&& !wanted.has(top))delete this.value[this.key];};for await(const c of fs.createReadStream('docs/material-input-equivalence-audit.json.gz').pipe(createGunzip())){hash.update(c);p.write(c);}const manifest=JSON.parse(fs.readFileSync('docs/material-input-equivalence-audit.json'));assert.equal(hash.digest('hex'),manifest.uncompressedSha256);for(const [k,v]of Object.entries(census.sectionDigests))assert.equal(found[k].sha256,v,k);console.log(JSON.stringify({producerArgs:process.execArgv,generation:manifest.compressedSha256,sections:found,exactRegisteredCensus:true,priorConservation:'Bound to retained registration census;does not certify rendering or cold replay.'}));"],"generation":"7fa7ca3503d018f59009dd4dfdcd86213d1af3f5d31bc089d3d201f42c0ae802","sections":{"sourceFingerprints":{"count":873,"sha256":"86585d344af2f5fb1fbed25fc97ad2b4bd0936ab0c604c7ce6471e55301702e0"},"sourceFindings":{"count":180,"sha256":"8f5995bd82bffb42ea30f9744f7a2f75c68504507c2296869548412b40bfd307"},"focusedProofs":{"count":243,"sha256":"14a50b0d27ef7040ae4513c451daad73cc702142910f9beb1fcce88f07cbe0da"}},"exactRegisteredCensus":true,"priorConservation":"Bound to retained registration census;does not certify rendering or cold replay."}
