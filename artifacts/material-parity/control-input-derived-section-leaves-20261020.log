import assert from 'node:assert/strict';
import { createReadStream, readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { createGunzip } from 'node:zlib';
import { PassThrough, Transform } from 'node:stream';
import { pipeline } from 'node:stream/promises';
import { sectionDigests, compareSectionLeaves } from './scripts/material-audit-section-digests.mjs';
const hash=b=>createHash('sha256').update(b).digest('hex');
const oldIndex=JSON.parse(readFileSync('artifacts/material-parity/working-audit/39fc0e3ef3d12a4d2c2fc47c8731ea10644012c41a60eca83bcbff3199a3fdb7/index.json'));
const previous={manifest:oldIndex.manifest},currentManifest=JSON.parse(readFileSync('docs/material-input-equivalence-audit.json'));
assert.equal(currentManifest.compressedSha256,'b6610e71ef744b5d589d07c18e562df9927202a3adb7a5b31acb334b100839f2');
const oldPayload='artifacts/material-parity/working-audit/'+previous.manifest.compressedSha256+'/'+previous.manifest.payload,newPayload='docs/'+currentManifest.payload;
for(const [file,manifest]of [[oldPayload,previous.manifest],[newPayload,currentManifest]]){const b=readFileSync(file);assert.equal(b.length,manifest.compressedBytes);assert.equal(hash(b),manifest.compressedSha256);}
const names=['controlLineBoxes','controlTypography','discrepancies','ownerCaretInputs','reviewedSourceBatchInputs'];

function decoded(file){const state={bytes:0,hash:createHash('sha256')},out=new PassThrough();const tap=new Transform({transform(chunk,encoding,callback){state.bytes+=chunk.length;state.hash.update(chunk);callback(null,chunk);}});const completion=pipeline(createReadStream(file),createGunzip(),tap,out).then(()=>({ok:true}),error=>({ok:false,error:String(error)}));return{out,state,completion};}
const before=decoded(oldPayload),after=decoded(newPayload);
const comparison=await compareSectionLeaves(before.out,after.out,names);
const streams=await Promise.all([before.completion,after.completion]);
const receipts=[before,after].map((v,i)=>{const manifest=i?currentManifest:previous.manifest,sha256=v.state.hash.digest('hex');return{bytes:v.state.bytes,sha256,complete:v.state.bytes===manifest.uncompressedBytes&&sha256===manifest.uncompressedSha256,stream:streams[i]};});
assert.ok(receipts.every(r=>r.complete&&r.stream.ok));
console.log(JSON.stringify({previousManifest:previous.manifest,currentManifest,selectedSections:names,receipts,comparison,approved:false,scope:'Authenticated full streams and exact five-section leaf comparison using existing compareSectionLeaves. No duplicate section-digest collection;full80-section result retained separately. Changes require attribution,not acceptance.'}));

