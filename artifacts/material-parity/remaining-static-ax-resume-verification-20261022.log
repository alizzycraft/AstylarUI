{"producerArgs":["--input-type=module","-e","import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';\nconst hash=b=>createHash('sha256').update(b).digest('hex'),root='artifacts/material-parity/remaining-static-ax-resume-20261022',file=root+'/latest-report.json',bytes=fs.readFileSync(file),report=JSON.parse(bytes),p=report.provenance;\nconst authenticate=r=>assert.equal(hash(fs.readFileSync(r.file)),r.sha256);for(const r of Object.values(p).filter(r=>r?.file&&r?.sha256))authenticate(r);\nassert.equal(p.checkpoint.sha256,'9d0f1220ea6c2ca95cbfb143d94f7f5680a0d8cb11e074db879768f9763fd5b0');assert.equal(report.observations.length,678);assert.equal(p.reusedCompletedObservations.length,2);\nconst configured=JSON.parse(fs.readFileSync(p.report.file)).results;assert.equal(configured.length,436);const key=r=>`${r.family}/${r.profile}/${r.viewport.id}/${r.mode}`,expected=new Map(configured.flatMap(r=>['reference','astylar'].map(mode=>[key({...r,mode}),r])));assert.equal(expected.size,872);const observed=new Set(),counts={new:0,prior:0,partial:0};\nfunction observe(row,rawFile,family,kind){const b=fs.readFileSync(rawFile);assert.equal(hash(b),row.sha256);const o=JSON.parse(b),k=key({...row,family});assert.ok(expected.has(k));assert.ok(!observed.has(k));observed.add(k);assert.deepEqual(row.viewport,expected.get(k).viewport);assert.deepEqual(o.viewport,row.viewport);assert.equal(o.mode,row.mode);assert.equal(o.profile,row.profile);if(row.family!==undefined)assert.equal(o.family,family);else assert.equal(o.target.astylarId??o.target.id,'list-primary');assert.equal(o.browser,'155.0.8059.80');assert.deepEqual(o.runtimeErrors,[]);assert.equal(o.nodes.length,row.axNodes??o.nodes.length);assert.equal(new Set(o.nodes.map(n=>n.nodeId)).size,o.nodes.length);counts[kind]++;}\nfor(const row of report.observations)observe(row,path.join(root,row.file),row.family,'new');\nfor(const r of p.reusedStaticAxReports){authenti