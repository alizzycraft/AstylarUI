import assert from 'node:assert/strict';import {readFileSync,createReadStream} from 'node:fs';import {createHash} from 'node:crypto';import path from 'node:path';import Parser from 'jsonparse';
const hash=x=>createHash('sha256').update(x).digest('hex'),serialized=x=>hash(JSON.stringify(x,null,2)+'\n');
const file='artifacts/material-parity/control-input-derived-section-leaves-20261020.log',bytes=readFileSync(file);assert.equal(hash(bytes),'b56d07f7e2182b5953c7e14efd65bad8984065ac2976ffcc78c5c728008ddc5a');
const marker='\nTerminal exit: 0\n',readResult=b=>{const text=b.toString(),at=text.lastIndexOf(marker);assert.ok(at>0);return JSON.parse(text.slice(at+marker.length));};
const result=readResult(bytes);assert.ok(result.receipts.every(r=>r.complete&&r.stream.ok));
const sections=readResult(readFileSync('artifacts/material-parity/control-input-full-section-comparison-20261020.log'));
assert.deepEqual(sections.afterManifest,result.currentManifest);assert.deepEqual(sections.beforeManifest,result.previousManifest);assert.equal(sections.sections,80);assert.equal(sections.unchanged,70);
result.previous={manifest:result.previousManifest};result.current={manifest:result.currentManifest,sections:sections.afterSections};result.changed=sections.changed;
const oldModule='d2d49ef981833dc1e2fa6882c08e7527f0899aa4d65832b47d0571884450c6b4',newModule='d97e15b446f6fe5c53688f3ff504fed86dd1793d0912cb39f374a77abe9c6ea7';assert.equal(hash(readFileSync('tests/material-parity/input-equivalence-audit.mjs')),newModule);
const changes=result.comparison.changes,groups={};for(const c of changes){const key=c.path.map(p=>typeof p==='number'?'#':p).join('.');groups[key]=(groups[key]||0)+1;}assert.deepEqual(groups,{'controlLineBoxes.observations.#.normalizationReconciliation.currentModuleSha256':48,'controlTypography.differences.#.reviewEvidence.observation.normalizationReconciliation.currentModuleSha256':48,'discrepancies.#.reviewEvidence.proofs.#.controlProofSha256':48,'ownerCaretInputs.binding.completeSource.sources.#.current':1,'reviewedSourceBatchInputs.binding.sourceConservation.currentReportSha256':1,'reviewedSourceBatchInputs.binding.sourceConservation.sourceReceiptTransitions.#.currentSha256':1});
for(const c of changes.filter(c=>['currentModuleSha256','current','currentSha256'].includes(c.path.at(-1)))){assert.equal(c.before,oldModule);assert.equal(c.after,newModule);}
async function index(store,expected){const pointer=JSON.parse(readFileSync(path.join(store,'current.json')));assert.equal(pointer.generation,expected);const directory=path.join(store,pointer.generation),file=path.join(directory,'index.json'),parser=new Parser(),h=createHash('sha256'),data={};const keep=new Set(['manifest','shards','counts']);parser.onValue=function(value){const top=this.stack[1]?.key??(this.stack.length===1?this.key:undefined);if(this.stack.length===1){if(keep.has(this.key))data[this.key]=value;delete this.value[this.key];}else if(this.value&&!keep.has(top))delete this.value[this.key];};for await(const b of createReadStream(file)){h.update(b);parser.write(b);}assert.equal(h.digest('hex'),pointer.indexSha256);return{pointer,directory,...data};}
const previous=await index('artifacts/material-parity/working-audit',result.previous.manifest.compressedSha256),current=await index('artifacts/material-parity/working-audit-candidate-validation',result.current.manifest.compressedSha256);assert.deepEqual(previous.manifest,result.previous.manifest);assert.deepEqual(current.manifest,result.current.manifest);
const ordinals=new Set(changes.filter(c=>c.path[0]==='controlTypography').map(c=>c.path[2]));assert.equal(ordinals.size,48);
function selected(index){const found=new Map();for(const s of index.shards.filter(s=>s.file.startsWith('controlTypography-differences-'))){const b=readFileSync(path.join(index.directory,s.file));assert.equal(b.length,s.bytes);assert.equal(hash(b),s.sha256);for(const line of b.toString().trimEnd().split('\n')){const r=JSON.parse(line);if(ordinals.has(r.evidence.ordinal)){assert.equal(r.evidence.section,'controlTypography.differences');assert.equal(r.evidence.sourceSha256,index.manifest.uncompressedSha256);assert.ok(!found.has(r.evidence.ordinal));found.set(r.evidence.ordinal,r);}}}assert.equal(found.size,48);return found;}
const left=selected(previous),right=selected(current),pairs=[];for(const ordinal of ordinals){const a=left.get(ordinal),b=right.get(ordinal);assert.equal(a.case,b.case);assert.equal(a.element,b.element);assert.equal(a.property,b.property);pairs.push({ordinal,case:a.case,element:a.element,before:a.evidence.completeRowSha256,after:b.evidence.completeRowSha256});}
const scalar=changes.filter(c=>c.path[0]==='discrepancies');assert.equal(scalar.length,48);for(const c of scalar)assert.equal(pairs.filter(p=>p.before===c.before&&p.after===c.after).length,1,'scalar receipt must identify one actual before/after complete control proof');assert.equal(new Set(scalar.map(c=>c.before)).size,48);
const motion=JSON.parse(readFileSync('docs/material-owner-initial-motion-review.json'));for(const s of motion.sourceFingerprints)s.sha256=hash(readFileSync(s.file,'utf8').replaceAll('\r\n','\n'));const currentMotionSha=serialized(motion),beforeMotion=structuredClone(motion),receipt=beforeMotion.sourceFingerprints.filter(s=>s.file==='tests/material-parity/input-equivalence-audit.mjs');assert.equal(receipt.length,1);assert.equal(receipt[0].sha256,newModule);receipt[0].sha256=oldModule;const previousMotionSha=serialized(beforeMotion),change=changes.find(c=>c.path.at(-1)==='currentReportSha256');assert.equal(change.before,previousMotionSha);assert.equal(change.after,currentMotionSha);
assert.equal(changes.length,147);assert.equal(result.current.sections.length,80);assert.equal(result.changed.length,10);
console.log(JSON.stringify({producerArgs:process.execArgv,receipt:{file,sha256:hash(bytes)},previous:previous.pointer,current:current.pointer,changedSections:result.changed.map(s=>s.name),unchangedSections:70,groups,all48ScalarHashesMatchActualCompleteControlProofs:true,controlPairs:pairs,motion:{previousMotionSha,currentMotionSha,onlyChangedSourceReceipt:'tests/material-parity/input-equivalence-audit.mjs',oldModule,newModule},scope:'All 147 extra receipt changes attributed; complete authenticated leaf comparison preserves every other value and all shape/order. Not current rendering or case inspection acceptance; independent cold check and main publication still required.'}));
