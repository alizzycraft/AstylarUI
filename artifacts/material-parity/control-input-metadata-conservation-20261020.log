@'
import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const hash=b=>createHash('sha256').update(b).digest('hex');
function index(base,p){const b=fs.readFileSync(base+'/'+p.generation+'/index.json');assert.equal(hash(b),p.indexSha256);return JSON.parse(b)}
const main='artifacts/material-parity/working-audit',candidate=main+'-candidate-validation';
const a=index(main,JSON.parse(fs.readFileSync(main+'/current.json'))),b=index(candidate,JSON.parse(fs.readFileSync(candidate+'/current.json')));
const before=a.metadata.coverage,after=b.metadata.coverage;
let removed=0;for(const g of after.inspectionEvidence.cases)for(const [owner,key]of [['inputStyleStructure','retainedCheckboxMarkRequests'],['localPaint','retainedCheckboxDisabledInkRequests'],['semantics','retainedSelectListboxNamingRequests']])if(g.obligations[owner]?.[key]){delete g.obligations[owner][key];removed++}
assert.equal(removed,116);assert.deepEqual(after.inspectionEvidence.cases,before.inspectionEvidence.cases);
const oldDeps=new Map(before.inspectionEvidence.evidenceFingerprints.map(r=>[r.file,r.sha256]));
const added=after.inspectionEvidence.evidenceFingerprints.filter(r=>!oldDeps.has(r.file));
assert.equal(added.length,7);
assert.deepEqual(after.inspectionEvidence.evidenceFingerprints.filter(r=>oldDeps.has(r.file)),before.inspectionEvidence.evidenceFingerprints);
after.inspectionEvidence.evidenceFingerprints=before.inspectionEvidence.evidenceFingerprints;
const changes=[];
function diff(a,b,p=[]){if(Object.is(a,b))return;if(a&&b&&typeof a==='object'&&typeof b==='object'){assert.deepEqual(Object.keys(a),Object.keys(b),'shape '+p.join('.'));for(const k of Object.keys(a))diff(a[k],b[k],[...p,k]);}else changes.push({path:p,before:a,after:b})}
diff(before,after);
assert.deepEqual(changes.map(r=>r.path.join('.')),[
'inspectionEvidence.reviewSha256','inspectionEvidence.sourceApplicability.reviewSha256',
'inspectionEvidence.sourceApplicability.transitions.0.currentSha256','inspectionEvidence.sourceApplicability.transitions.1.currentSha256',
'inspectionEvidence.sourceApplicability.transitions.2.currentSha256','inspectionEvidence.sourceApplicability.transitions.3.currentSha256']);
for(const row of changes.slice(0,2)){assert.equal(row.before,'e837c58e3b9c0594f6003a6001a03cb12b4fa875403db08724e9c9defb329854');assert.equal(row.after,'736e685c55bf033db3d0ffc5b564e2ed42648438e1ed0b3ab66b7f26ed83d8bd');}
const log=fs.readFileSync('artifacts/material-parity/control-input-pre-export-source-census-20261020.log','utf8');
const tail=log.slice(log.indexOf('Note:'));const census=JSON.parse(tail.slice(tail.indexOf('\n{')));
for(const row of changes.slice(2)){const transition=after.inspectionEvidence.sourceApplicability.transitions[Number(row.path[3])];const expected=census.changed.find(r=>r.file===transition.logicalFile);assert.ok(expected);assert.equal(row.before,expected.before);assert.equal(row.after,expected.after);}
const summary=structuredClone(b.metadata.summary);assert.equal(summary.sourceFindings,170);summary.sourceFindings=166;assert.deepEqual(summary,a.metadata.summary);

console.log(JSON.stringify({authenticatedIndexes:true,complete2311PredecessorCasesConserved:true,removedOnlyChildren:removed,addedDependencies:added,all15185PriorDependencyReceiptsConserved:true,remainingCoverageLeafChanges:changes,summaryBefore:a.metadata.summary,summaryAfter:b.metadata.summary,scope:'Exact compact metadata conservation only;full payload section comparison,cold check and main import remain required.'},null,2));
