{"producerArgs":["--input-type=module","-e","import ts from 'typescript';import fs from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';import {sourceAuditDefinitions} from './tests/material-parity/input-equivalence-policy.mjs';import {sectionDigests} from './scripts/material-audit-section-digests.mjs';const source=fs.readFileSync('tests/material-parity/input-equivalence-audit.mjs','utf8');const ast=ts.createSourceFile('audit.mjs',source,ts.ScriptTarget.Latest,true);const bodies=['scanMaterialSources','sourceFingerprints','focusedProofInventory','proof'].map(name=>{const n=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);assert.ok(n);return n.getText(ast)}).join('\\n');const f=new Function('readFileSync','path','createHash','sourceAuditDefinitions',bodies+'\\nreturn {scanMaterialSources,sourceFingerprints,focusedProofInventory};')(fs.readFileSync,path,createHash,sourceAuditDefinitions);const sources=f.sourceFingerprints(process.cwd()),proofs=f.focusedProofInventory(process.cwd()),findings=f.scanMaterialSources(process.cwd());assert.deepEqual([sources.length,proofs.length,findings.length],[756,226,170]);assert.ok(findings.every(f=>f.detected));assert.equal(proofs.filter(p=>p.status==='missing').length,0);const report=JSON.parse(fs.readFileSync('artifacts/material-parity/divider-property-full-section-comparison-recovered-20261020.log'));assert.deepEqual(report.changed.map(s=>s.name),['sourceFingerprints','coverage']);assert.deepEqual(report.added,[]);assert.deepEqual(report.removed,[]);const actual=await sectionDigests([Buffer.from(JSON.stringify({sourceFingerprints:sources,focusedProofs:proofs,sourceFindings:findings}))]);for(const s of actual)assert.deepEqual(s,report.current.sections.find(r=>r.name===s.name));const census=JSON.parse(fs.readFileSync('artifacts/material-parity/divider-property-pre-export-source-census-20261020.log'));assert.equal(census.changes.length,3);for(const c of census.changes){const rows=sources.filter(s=>s.file===c.file);assert.equal(rows.length,1);assert.equal(rows[0].sha256,c.after);rows[0].sha256=c.before}const restored=await sectionDigests([Buffer.from(JSON.stringify({sourceFingerprints:sources,focusedProofs:proofs,sourceFindings:findings}))]);for(const s of restored)assert.deepEqual(s,census.completeAcceptedSectionsRecovered.find(r=>r.name===s.name));console.log(JSON.stringify({producerArgs:process.execArgv,sections:80,unchanged:78,changed:['sourceFingerprints','coverage'],actualRegistrationSections:actual,restoredAcceptedSections:restored,exactThreeSourceTransitions:census.changes,all756Sources226Proofs170FindingsConserved:true,scope:'Source sections exactly equal current production inventory;only three reviewed fingerprints differ from accepted. Complete coverage conservation is separate;independent cold replay/main import still required.'}));"],"sections":80,"unchanged":78,"changed":["sourceFingerprints","coverage"],"actualRegistrationSections":[{"name":"sourceFingerprints","tokens":7561,"sha256":"ba4759838feedf2909d5ce2dfabc1db31293e1ed8698762e5a2fdf23a014fa8f"},{"name":"focusedProofs","tokens":4069,"sha256":"4e2af61eb73d9cf3c355c6bc9756b8b69ac8562c1eea8584dad4890ccc734782"},{"name":"sourceFindings","tokens":13705,"sha256":"37576baca1835749da538196a70b44238623c5d02b3a4b0cc456ac1ad66dd765"}],"restoredAcceptedSections":[{"name":"sourceFingerprints","tokens":7561,"sha256":"5b971ab52e7f80448e9f65ac1d8f51b1233322fb1a5ae7e31b80df2213db2fc7"},{"name":"focusedProofs","tokens":4069,"sha256":"4e2af61eb73d9cf3c355c6bc9756b8b69ac8562c1eea8584dad4890ccc734782"},{"name":"sourceFindings","tokens":13705,"sha256":"37576baca1835749da538196a70b44238623c5d02b3a4b0cc456ac1ad66dd765"}],"exactThreeSourceTransitions":[{"file":"tests/material-parity/text-backing-case-review-source.mjs","before":"711a706d07e7be74b2e66bfe482f3609690fdbf2544298f30f98940de3806f12","after":"36f828cd27ec32129d21fa492c736d46587e7c31360ceb505fc9e37c8