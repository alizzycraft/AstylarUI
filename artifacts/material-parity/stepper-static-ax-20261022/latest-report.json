 candidate.startsWith(browserRoot + path.sep) && path.extname(candidate) && existsSync(candidate)\n      ? candidate : path.join(browserRoot, 'index.csr.html');\n    const extension = path.extname(target);\n    response.writeHead(200, { 'content-type': extension === '.js' ? 'text/javascript' :\n      extension === '.css' ? 'text/css' : extension === '.woff2' ? 'font/woff2' : 'text/html' });\n    response.end(readFileSync(target));\n  });\n  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));\n  let browser;\n  try {\n    browser = await chromium.launch({ channel: 'chrome', headless: true, ...launchOptions });\n    await run(browser, `http://127.0.0.1:${server.address().port}`);\n  } finally {\n    if (browser) await browser.close();\n    await new Promise(resolve => server.close(resolve));\n  }\n}","helperSha256":"603ac9ca88b9bf2e3443f8be65f125d39002e1ca4e5157487d9ac86ed7d2527f","checkpointHelper":{"file":"tests/material-parity/run-checkpoint.mjs","sha256":"50d158b495bb881a126f76787f679e14702857f59c0f338e962bef57bf4394e0"}},"observations":[{"family":"stepper","profile":"light","viewport":{"id":"desktop","width":1440,"height":1000,"deviceScaleFactor":1},"mode":"reference","file":"stepper-light-1440x1000-dpr1-reference.json","sha256":"da12aef1c2ae05ff870dc2cf6dc941c3e9ea15759bd263caf547dd327a3101e6","axNodes":43,"describedBackendNodes":38},{"family":"stepper","profile":"light","viewport":{"id":"desktop","width":1440,"height":1000,"deviceScaleFactor":1},"mode":"astylar","file":"stepper-light-1440x1000-dpr1-astylar.json","sha256":"eeef28e96a152bb875320fe8e800f5f056d1736ab65ee2028c124c2ae641e638","axNodes":36,"describedBackendNodes":29},{"family":"stepper","profile":"light","viewport":{"id":"tablet","width":768,"height":1024,"deviceScaleFactor":1},"mode":"reference","file":"stepper-light-768x1024-dpr1-reference.json","sha256":"48add3de068006814d70f274285aed4897e16b4bd9c54472150b1e940d1a0444","axNodes":43,"describedBackendNodes":38},{"family":"stepper","