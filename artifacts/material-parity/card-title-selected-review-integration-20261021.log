{"producerArgs":["--max-old-space-size=8192","--input-type=module","-e","import fs from\"node:fs\";import assert from\"node:assert/strict\";import{createHash}from\"node:crypto\";import{loadCaseObligationReview}from\"./scripts/audit-findings-store.mjs\";import{createDividerReviewedBoundariesReader,cardInputsReview,passiveStaticAxReview}from\"./tests/material-parity/text-backing-case-review-source.mjs\";const hash=x=>createHash(\"sha256\").update(x).digest(\"hex\"),file=\"artifacts/material-parity/working-audit/proposals/\"+cardInputsReview+\".json\",bytes=fs.readFileSync(file),review=JSON.parse(bytes).review;assert.equal(hash(JSON.stringify(review)),cardInputsReview);const reader=createDividerReviewedBoundariesReader({root:process.cwd(),read:fs.readFileSync,reviewSha256:cardInputsReview});assert.equal(reader.sourceApplicability.currentSourceChecks.length,12);assert.throws(()=>createDividerReviewedBoundariesReader({root:process.cwd(),read:fs.readFileSync,reviewSha256:\"0\".repeat(64)}));const loaded=loadCaseObligationReview(file,cardInputsReview,review.groups.map(g=>g.case),{read:reader.read});assert.equal(loaded.cases.length,2311);assert.equal(loaded.inspectionComplete,false);assert.equal(loaded.currentRenderingAccepted,false);assert.deepEqual(loaded.unjoinedCases,[]);let nodes=0,ax=0;for(const row of review.groups){assert.equal(row.inspection,\"partial\");assert.equal(row.currentRendering,\"unverified\");if(row.family!==\"card\")continue;if(row.obligations.inputStyleStructure.recordedCardNodeAccounting){delete row.obligations.inputStyleStructure.recordedCardNodeAccounting;nodes++}if(row.obligations.semantics.currentStaticActualAx){assert.ok(row.case.startsWith(\"static:\"));delete row.obligations.semantics.currentStaticActualAx;ax++}}assert.equal(nodes,52);assert.equal(ax,12);assert.equal(hash(JSON.stringify(review)),passiveStaticAxReview);console.log(JSON.stringify({producerArgs:process.execArgv,proposal:{file,sha256:hash(bytes),reviewSha256:cardInputsReview},cases:2311,addedNodeCases:nodes,addedAxCases:ax,validatedDependencies:loaded.evidenceFingerprints.length,sourceChecks:12,completePredecessorRecovered:true,inspectionComplete:false,currentRenderingAccepted:false,canonicalPublication:false}));"],"proposal":{"file":"artifacts/material-parity/working-audit/proposals/20dfb80485f094eaec4025e56ac7d5bb4a375f388643d192cb14f5d5fecbf82b.json","sha256":"f4055e63730c5507d720daf057cfb3c5c08a393991a1295b8ba9564ac9ed8354","reviewSha256":"20dfb80485f094eaec4025e56ac7d5bb4a375f388643d192cb14f5d5fecbf82b"},"cases":2311,"addedNodeCases":52,"addedAxCases":12,"validatedDependencies":15420,"sourceChecks":12,"completePredecessorRecovered":true,"inspectionComplete":false,"currentRenderingAccepted":false,"canonicalPublication":false}
