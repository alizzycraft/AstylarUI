       case 'text': return InputType.Text;\n            case 'password': return InputType.Password;\n            case 'email': return InputType.Email;\n            case 'number': return InputType.Number;\n            case 'range': return InputType.Range;\n            case 'button': return InputType.Button;\n            case 'submit': return InputType.Submit;\n            case 'reset': return InputType.Button;\n            case 'checkbox': return InputType.Checkbox;\n            case 'radio': return InputType.Radio;\n            case 'select': return InputType.Select;\n            case 'textarea': return InputType.Textarea;\n            default: return null;\n        }\n    }"}],"creationMethod":{"line":77,"sha256":"09149f3db1548f87b680772b13de0fb89c314dc70192666ba050ae5b7baa10ea"},"cases":68,"owners":136,"observations":[{"case":"static:radio@light/desktop","value":"solo","roleInput":{"type":"div","id":"radio-solo","class":"radio-option","role":"radio","tabindex":-1,"ariaChecked":false,"ariaDisabled":false},"nativeInput":{"type":"input","inputType":"radio","id":"mat-radio-0-input","name":"mat-radio-group-0","checked":false},"roleDispatch":null,"nativeDispatch":"radio"},{"case":"static:radio@light/desktop","value":"team","roleInput":{"type":"div","id":"radio-team","class":"radio-option","role":"radio","tabindex":0,"ariaChecked":true,"ariaDisabled":false},"nativeInput":{"type":"input","inputType":"radio","id":"mat-radio-1-input","name":"mat-radio-group-0","checked":true},"roleDispatch":null,"nativeDispatch":"radio"},{"case":"static:radio@light/tablet","value":"solo","roleInput":{"type":"div","id":"radio-solo","class":"radio-option","role":"radio","tabindex":-1,"ariaChecked":false,"ariaDisabled":false},"nativeInput":{"type":"input","inputType":"radio","id":"mat-radio-0-input","name":"mat-radio-group-0","checked":false},"roleDispatch":null,"nativeDispatch":"radio"},{"case":"static:radio@light/tablet","value":"team","roleInput":{"type":"div","id":"radio-team","class":"rad