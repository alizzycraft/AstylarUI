@'
import ts from 'typescript';import fs from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';import assert from 'node:assert/strict';import {sourceAuditDefinitions} from './tests/material-parity/input-equivalence-policy.mjs';import {sectionDigests} from './scripts/material-audit-section-digests.mjs';
const file='tests/material-parity/input-equivalence-audit.mjs',source=fs.readFileSync(file,'utf8'),ast=ts.createSourceFile(file,source,ts.ScriptTarget.Latest,true),names=['scanMaterialSources','sourceFingerprints','focusedProofInventory','proof'];
const bodies=names.map(name=>{const n=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);assert.ok(n);return n.getText(ast)}).join('\n');
const f=new Function('readFileSync','path','createHash','sourceAuditDefinitions',bodies+'\nreturn {scanMaterialSources,sourceFingerprints,focusedProofInventory};')(fs.readFileSync,path,createHash,sourceAuditDefinitions);
const sources=f.sourceFingerprints(process.cwd()),proofs=f.focusedProofInventory(process.cwd()),findings=f.scanMaterialSources(process.cwd());
assert.deepEqual([sources.length,proofs.length,findings.length],[756,226,170]);assert.equal(proofs.filter(p=>p.status==='missing').length,0);assert.ok(findings.every(f=>f.detected));
