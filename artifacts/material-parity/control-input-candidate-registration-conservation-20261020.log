const actual=await sectionDigests([Buffer.from(JSON.stringify({sourceFingerprints:sources,focusedProofs:proofs,sourceFindings:findings}))]);
for(const row of actual)assert.deepEqual(row,expected.find(r=>r.name===row.name));
console.log(JSON.stringify({counts:{sources:sources.length,proofs:proofs.length,findings:findings.length},sections:actual,exactCandidateRegistrationSections:true,scope:'Unchanged production functions extracted through TypeScript AST;all actual candidate source/finding/proof section tokens equal current production output. Prior populations conserve through the authenticated pre-export source census. No full builder/browser recapture.'},null,2));
