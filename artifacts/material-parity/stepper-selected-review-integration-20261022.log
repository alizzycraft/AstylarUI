{"producerArgs":["--input-type=module","-e","import fs from 'node:fs';import assert from 'node:assert/strict';import{createHash}from'node:crypto';import{loadCaseObligationReview}from'./scripts/audit-findings-store.mjs';import{createDividerReviewedBoundariesReader,stepperInputsReview,expansionSemanticsReview}from'./tests/material-parity/text-backing-case-review-source.mjs';\nconst root=process.cwd(),base='artifacts/material-parity/working-audit',hash=b=>createHash('sha256').update(b).digest('hex'),pointer=fs.readFileSync(base+'/current.json'),file=base+'/proposals/'+stepperInputsReview+'.json',envelope=JSON.parse(fs.readFileSync(file));assert.equal(hash(JSON.stringify(envelope.review)),stepperInputsReview);const review=envelope.review;assert.equal(review.groups.length,2311);const reader=createDividerReviewedBoundariesReader({root,read:fs.readFileSync,reviewSha256:stepperInputsReview});const loaded=loadCaseObligationReview(file,stepperInputsReview,review.groups.map(g=>g.case),{read:reader.read});assert.equal(loaded.cases.length,2311);assert.deepEqual(loaded.unjoinedCases,[]);assert.equal(loaded.inspectionComplete,false);assert.equal(loaded.currentRenderingAccepted,false);let expansion=0,stepper=0,ax=0;for(const g of review.groups){assert.equal(g.inspection,'partial');assert.equal(g.currentRendering,'unverified');if(g.family==='expansion'){const o=g.obligations.inputStyleStructure;assert.ok(o.recordedExpansionNodeAccounting);delete o.recordedExpansionNodeAccounting;expansion++;}if(g.family==='stepper'){const o=g.obligations.inputStyleStructure;assert.ok(o.recordedStepperNodeAccounting);delete o.recordedStepperNodeAccounting;stepper++;if(g.case.startsWith('static:')){assert.ok(g.obligations.semantics.currentStaticActualAx);delete g.obligations.semantics.currentStaticActualAx;ax++;}}}assert.deepEqual([expansion,stepper,ax],[68,68,12]);assert.equal(hash(JSON.stringify(review)),expansionSemanticsReview);assert.deepEqual(fs.readFileSync(base+'/current.json'),pointer);assert