{
  "name": "astylarui",
  "version": "0.2.0",
  "description": "A 3D UI rendering library that renders HTML-like structures in BabylonJS scenes",
  "type": "module",
  "main": "dist/lib/lib/index.js",
  "module": "dist/lib/lib/index.js",
  "types": "dist/lib/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/lib/index.d.ts",
      "import": "./dist/lib/lib/index.js",
      "default": "./dist/lib/lib/index.js"
    }
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "node scripts/build-library.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "parity": "node tests/parity/run-parity.mjs",
    "parity:check": "node tests/parity/run-parity.mjs --enforce",
    "parity:tailwind:check": "node tests/parity/run-parity.mjs --fixture=tailwind-loaded-utilities --enforce-focused",
    "parity:harness:check": "node --test tests/parity/fixture-manifest.spec.mjs tests/parity/visibility-metrics.spec.mjs tests/parity/sharpness-metrics.spec.mjs tests/tts-parity/benchmark-config.spec.mjs tests/tts-parity/demo-workflow.spec.mjs tests/tts-parity/scrolling-metrics.spec.mjs tests/tts-parity/interaction-metrics.spec.mjs tests/material-parity/benchmark-config.spec.mjs tests/material-parity/cursor-metrics.spec.mjs tests/material-parity/focused-raster-metrics.spec.mjs tests/material-parity/text-alignment-metrics.spec.mjs tests/material-parity/shadow-profile-metrics.spec.mjs tests/material-parity/input-tree-evidence.spec.mjs tests/material-parity/input-equivalence-audit.spec.mjs tests/material-parity/input-audit-report-codec.spec.mjs tests/material-parity/normal-line-box-report.spec.mjs",
    "tts-parity:report": "node tests/tts-parity/run-tts-parity.mjs",
    "tts-parity:check": "node tests/tts-parity/run-tts-parity.mjs --enforce",
    "parity:release:check": "npm run parity:check && npm run tts-parity:check && npm run material-parity:check",
    "consumer:check": "node scripts/consumer-check.mjs",
    "tts-demo:prepare": "node scripts/prepare-tts-demo.mjs",
    "tts-demo:check": "node scripts/tts-demo-check.mjs",
    "material-showcase:prepare": "node scripts/prepare-material-showcase.mjs",
    "material-showcase:build": "npm run material-showcase:prepare && npm --prefix examples/material-showcase run build",
    "material-showcase:test": "npm run material-showcase:prepare && npm --prefix examples/material-showcase test -- --watch=false --browsers=ChromeHeadless",
    "material-showcase:serve": "npm run material-showcase:prepare && npm --prefix examples/material-showcase start",
    "material-showcase:check": "node scripts/material-showcase-check.mjs",
    "material-showcase:runtime:check": "node tests/material-parity/normal-runtime-smoke.mjs",
    "material-parity:report": "node tests/material-parity/run-material-parity.mjs",
    "material-parity:check": "node tests/material-parity/run-material-parity.mjs --enforce",
    "material-input-audit": "node scripts/run-material-input-audit.mjs",
    "material-input-audit:check": "node scripts/run-material-input-audit.mjs --check",
    "material-input-audit:line-box:test": "node --test tests/material-parity/normal-line-box-evidence.spec.mjs",
    "capabilities:check": "node scripts/check-capability-catalog.mjs",
    "examples:check": "node scripts/check-translation-examples.mjs",
    "skill:references:sync": "npm run skill:developer:references:sync",
    "skill:references:check": "npm run skill:developer:references:check",
    "skill:developer:references:sync": "node .agents/skills/astylarui-developer/scripts/sync-references.mjs --write",
    "skill:developer:references:check": "node .agents/skills/astylarui-developer/scripts/sync-references.mjs --check",
    "skill:developer:check": "npm run skill:developer:references:check && node .agents/skills/astylarui-developer/scripts/validate-skill.mjs",
    "skill:maintainer:check": "node .agents/skills/astylarui-maintainer/scripts/validate-skill.mjs",
    "skill:check": "npm run skill:developer:check && npm run skill:maintainer:check",
    "serve:ssr:astylarui": "node dist/astylarui/server/server.mjs",
    "prepublishOnly": "npm run build:lib",
    "build:gh-pages": "ng build --base-href /AstylarUI/ --configuration production",
    "deploy": "npm run build:gh-pages && npx angular-cli-ghpages --dir=dist/astylarui/browser"
  },
  "keywords": [
    "babylonjs",
    "3d",
    "ui",
    "rendering",
    "angular",
    "webgl"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/the-erin-collective/AstylarUI"
  },
  "license": "AGPL-3.0",
  "peerDependencies": {
    "@angular/core": "^20.0.0",
    "@babylonjs/core": "^8.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^20.0.5",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.5",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.3",
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.15.1",
    "@ngrx/operators": "^20.0.0-beta.0",
    "@ngrx/signals": "^20.0.0-beta.0",
    "compare-versions": "^6.1.1",
    "express": "^5.1.0",
    "round-polygon": "^0.6.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.3",
    "@angular/cli": "^20.0.3",
    "@angular/compiler-cli": "^20.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/babylonjs": "^2.3.31",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^2.0.3",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "ssim.js": "^3.5.0",
    "tailwindcss": "4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2"
  }
}
